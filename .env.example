# Ambiente da aplicação
NODE_ENV=production
PORT=3000

# MySQL (local ou gerenciado)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lifebox_db

# TLS/SSL do MySQL gerenciado
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Certificado CA em PEM fornecido pelo provedor (use \n para quebras de linha)
DB_SSL_CA=
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10

# Dados demonstrativos: mantenha false em produção
SEED_DEMO_DATA=false

# Simulação local
SIMULATOR_INTERVAL_MS=2000
ALERT_COOLDOWN_SECONDS=30
API_BASE_URL=
