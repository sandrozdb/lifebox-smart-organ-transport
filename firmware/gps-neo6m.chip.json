{
  "name": "NEO-6M GPS",
  "author": "Sandro Ferreira",
  "pins": ["VCC", "GND", "TX", "RX"],
  "controls": [
    {
      "id": "latitude",
      "label": "Latitude",
      "type": "range",
      "min": -90,
      "max": 90,
      "step": 0.0001
    },
    {
      "id": "longitude",
      "label": "Longitude",
      "type": "range",
      "min": -180,
      "max": 180,
      "step": 0.0001
    },
    {
      "id": "speedKmh",
      "label": "Velocidade (km/h)",
      "type": "range",
      "min": 0,
      "max": 200,
      "step": 1
    }
  ]
}
